#
# Systemd configuration file for the Nginx session manager.
# Copy to /etc/systemd/system to access.
#
[Unit]
Description=Nginx Session Manager
After=network.target

[Service]
Type=forking
PIDFile=/run/sessmgr.pid
ExecStart=ngxsessmgr -r /var
ExecStop=-/sbin/start-stop-daemon --quiet --stop --retry TERM/5 --pidfile /run/sessmgr.pid
TimeoutStopSec=5
KillMode=mixed

[Install]
WantedBy=multi-user.target
